# ─────────────────────────────────────────────────────────────────────────────
# KAREERIST FRONTEND ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY NOTICE:
# ONLY variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put private API keys, backend secrets, Supabase service_role keys,
# Stripe secret keys, database passwords, or JWT secrets in any FRONTEND .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Client Configuration (Public Anon Key ONLY)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Backend API Base URL (empty for relative /api in dev via Vite proxy)
VITE_API_BASE=

# Local Development WSL / LAN IP (optional, for local network testing)
VITE_WSL_IP=

# Sentry Error Monitoring DSN (Public Client DSN)
VITE_SENTRY_DSN=

# EmailJS Configuration for Contact Form (Public Client Keys ONLY)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Blog Supabase Configuration (Optional, Public Anon Key ONLY)
VITE_BLOG_SUPABASE_URL=
VITE_BLOG_SUPABASE_ANON_KEY=
